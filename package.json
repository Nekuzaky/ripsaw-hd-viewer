{
  "name": "ripview",
  "productName": "RipView",
  "version": "1.0.0",
  "description": "Low-latency, high-quality viewer for the Razer Ripsaw HD capture card. Play your console on your PC without OBS or Streamlabs.",
  "main": "./out/main/index.js",
  "author": "Nekuzaky",
  "license": "MIT",
  "homepage": "https://github.com/Nekuzaky/ripview",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nekuzaky/ripview.git"
  },
  "keywords": [
    "razer",
    "ripsaw",
    "capture-card",
    "ps5",
    "xbox",
    "switch",
    "viewer",
    "low-latency",
    "electron"
  ],
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dist": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8"
  }
}
